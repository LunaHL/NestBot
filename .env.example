# Discord Bot Token
BOT_TOKEN= YOUR_BOT_TOKEN
CLIENT_ID= YOUR_CLIENT_ID
GUILD_ID= YOUR_GUILD_ID
SCOREBOARD_CHANNEL_ID= YOUR_SCOREBOARD_CHANNEL_ID

# Google Gemini API key (needed for the AI chat when you ping the bot)
GEMINI_API_KEY= YOUR_GEMINI_API_KEY

# AI models to try, in order (comma-separated). The bot logs a warning at startup
# if one doesn't exist and lists the available ones.
# AI_MODELS= gemini-2.5-flash,gemini-2.5-flash-lite

# Turn on the Halloween event on any day, for testing. Normally only October 31.
# FORCE_HALLOWEEN= true

# Only for `npm run coffee-art` (one-time picture generator). Default: gemini-2.5-flash-image
# COFFEE_IMAGE_MODEL= gemini-2.5-flash-image

# Time zone for daily resets, scoreboard and birthdays (default: Europe/Berlin)
# TIMEZONE= Europe/Berlin

# Uncomment the next line to enable debuging features
# DEBUG = True
