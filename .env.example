# Discord Bot Token
BOT_TOKEN= YOUR_BOT_TOKEN
CLIENT_ID= YOUR_CLIENT_ID
GUILD_ID= YOUR_GUILD_ID
SCOREBOARD_CHANNEL_ID= YOUR_SCOREBOARD_CHANNEL_ID

# Google Gemini API key (needed for the AI chat when you ping the bot)
GEMINI_API_KEY= YOUR_GEMINI_API_KEY

# AI models to try, in order (comma-separated). The bot logs a warning at startup
# if one doesn't exist and lists the available ones.
# AI_MODELS= gemini-2.5-flash,gemini-2.5-flash-lite

# Turn on the Halloween event on any day, for testing. Normally only October 31.
# FORCE_HALLOWEEN= true

# Only for `npm run drink-art` (one-time picture generator). Default: gemini-2.5-flash-image
# DRINK_IMAGE_MODEL= gemini-2.5-flash-image

# Movie nights: movie/series/anime info from TMDB (free for non-commercial use).
# Get the "API Read Access Token" at https://www.themoviedb.org/settings/api
# Without it /watch still works, just without posters, lengths and streaming info.
# TMDB_TOKEN= YOUR_TMDB_READ_ACCESS_TOKEN

# Time zone for daily resets, scoreboard and birthdays (default: Europe/Berlin)
# TIMEZONE= Europe/Berlin

# You (the person who runs the bot): your Discord user ID (Developer Mode on,
# right-click your name → Copy User ID). NestBot DMs you a ZIP backup of all
# data once a week and tells you about bad errors (crashes, commands that
# failed for someone). Leave empty for no DMs.
# MAINTAINER_ID= YOUR_DISCORD_USER_ID

# Days between backup DMs (default 7, 0 = no backup DMs, errors still come)
# BACKUP_DM_DAYS= 7

# Only for `npm run menu`, if it can't find the bot in pm2 by itself
# NESTBOT_PM2_NAME= nestbot

# Uncomment the next line to enable debuging features
# DEBUG = True
